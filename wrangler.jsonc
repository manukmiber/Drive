          "name": "RL_DOWNLOAD",
          "namespace_id": "2005",
          "simple": {
            "limit": 600,
            "period": 60
          }
        },
        {
          "name": "RL_AD_BOOK",
          "namespace_id": "2006",
          "simple": {
            "limit": 20,
            "period": 60
          }
