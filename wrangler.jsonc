// Zeiko Cloud Storage — Wrangler config.
// Top level = local dev reference only (dev runs on Node shims, ADR-001; never deployed).
// Bindings are not inherited by environments, so staging/production repeat them.
// Secrets (wrangler secret put …): BETTER_AUTH_SECRET, DOWNLOAD_SECRET, SHARE_LINK_SECRET,
//   SHARE_LINK_SECRET_PREV (rotation only), PREVIEW_SECRET, CONTACTS_ENC_KEY, IP_HASH_SECRET,
//   PAYMENT_WEBHOOK_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TELEGRAM_BOT_TOKEN,
//   TELEGRAM_WEBHOOK_SECRET, TURNSTILE_SECRET_KEY, MAIL_RELAY_TOKEN (ADAPTER_EMAIL=relay only).
//   ZEIKO_APP_TOKEN, ZEIKO_OPS_TOKEN (minted on the relay's Zeiko Drive screen, ADR-036).
//   CF_ACCOUNT_ID + CF_ANALYTICS_TOKEN (R2's own meters for the relay's storage tab, ADR-037).
//   S3_KEYS_ENC_KEY (32 random bytes, generated by cf-setup: seals Zeiko S3 secret keys, ADR-044).
//   VIRUSTOTAL_API_KEY (the owner's; unset = no VirusTotal in the scan, ADR-046).
// REPLACE_WITH_* ids are filled by scripts/cf-setup.mjs (deploy/{env}.json).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeiko",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "5 17 * * *",
      "0 * * * *",
      "0 19 * * *"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ArchiverContainer",
        "MediaContainer",
        "ScannerContainer"
      ]
    }
  ],
  "vars": {
    "APP_ENV": "dev",
    "APP_ORIGIN": "http://localhost:5173",
    "USERCONTENT_ORIGIN": "http://uc.localhost:8790",
    "S3_ORIGIN": "http://s3.localhost:8790",
    "EMAIL_FROM": "no-reply@zeiko.biz.id",
    "ADAPTER_EMAIL": "mock",
    "ADAPTER_PAYMENT": "mock",
    "ADAPTER_ACCOUNTS": "mock",
    "ADAPTER_SCANNER": "mock",
    "ADAPTER_CSAM": "mock",
    "ADAPTER_MEDIA": "mock",
    "ADAPTER_ARCHIVER": "mock",
    "R2_BUCKET_NAME": "zeiko-dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeiko-dev",
      "database_id": "local-dev",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "zeiko-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "local-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SCAN_QUEUE",
        "queue": "zeiko-scan-dev"
      },
      {
        "binding": "ARCHIVE_QUEUE",
        "queue": "zeiko-archive-dev"
      },
      {
        "binding": "COMPRESS_QUEUE",
        "queue": "zeiko-compress-dev"
      },
      {
        "binding": "NOTIFY_QUEUE",
        "queue": "zeiko-notify-dev"
      },
      {
        "binding": "CLEANUP_QUEUE",
        "queue": "zeiko-cleanup-dev"
      }
    ],
    "consumers": [
      {
        "queue": "zeiko-scan-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "zeiko-dlq-dev"
      },
      {
        "queue": "zeiko-archive-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "zeiko-dlq-dev"
      },
      {
        "queue": "zeiko-compress-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "zeiko-dlq-dev"
      },
      {
        "queue": "zeiko-notify-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "zeiko-dlq-dev"
      },
      {
        "queue": "zeiko-cleanup-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "zeiko-dlq-dev"
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "zeiko_events_dev"
    }
  ],
  "ratelimits": [
    {
      "name": "RL_AUTH",
      "namespace_id": "901",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_UPLOAD",
      "namespace_id": "902",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_SHARE_CREATE",
      "namespace_id": "903",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "RL_SHARE_SEND",
      "namespace_id": "904",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_DOWNLOAD",
      "namespace_id": "905",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "RL_AD_BOOK",
      "namespace_id": "906",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RL_REPORT",
      "namespace_id": "907",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "media": {
    "binding": "MEDIA"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "no-reply@zeiko.biz.id"
      ]
    }
  ],
  "env": {
    "staging": {
      "routes": [
        {
          "pattern": "staging.zeiko.biz.id",
          "custom_domain": true
        },
        {
          "pattern": "uc-staging.zeiko.biz.id",
          "custom_domain": true
        },
        {
          "pattern": "s3-staging.zeiko.biz.id",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "5 * * * *"
        ]
      },
      "vars": {
        "APP_ENV": "staging",
        "APP_ORIGIN": "https://staging.zeiko.biz.id",
        "USERCONTENT_ORIGIN": "https://uc-staging.zeiko.biz.id",
        "S3_ORIGIN": "https://s3-staging.zeiko.biz.id",
        "EMAIL_FROM": "no-reply@zeiko.biz.id",
        "ADAPTER_EMAIL": "relay",
        "MAIL_RELAY_URL": "https://mailer.zeiko.biz.id",
        "ADAPTER_PAYMENT": "zeiko",
        "ADAPTER_ACCOUNTS": "zeiko",
        "ZEIKO_DOOR_URL": "https://auth.zeiko.biz.id",
        "ZEIKO_SITE_URL": "https://zeiko.biz.id",
        "ADAPTER_SCANNER": "mock",
        "ADAPTER_CSAM": "mock",
        "ADAPTER_MEDIA": "cloudflare",
        "ADAPTER_ARCHIVER": "none",
        "R2_BUCKET_NAME": "zeiko-staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zeiko-staging",
          "database_id": "33413ba0-4a72-42db-8576-58ded9537076",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "zeiko-staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "9c35b1ed43174565bc1f540a8343baf2"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SCAN_QUEUE",
            "queue": "zeiko-scan-staging"
          },
          {
            "binding": "ARCHIVE_QUEUE",
            "queue": "zeiko-archive-staging"
          },
          {
            "binding": "COMPRESS_QUEUE",
            "queue": "zeiko-compress-staging"
          },
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "zeiko-notify-staging"
          },
          {
            "binding": "CLEANUP_QUEUE",
            "queue": "zeiko-cleanup-staging"
          }
        ],
        "consumers": [
          {
            "queue": "zeiko-scan-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-staging"
          },
          {
            "queue": "zeiko-archive-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-staging"
          },
          {
            "queue": "zeiko-compress-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-staging"
          },
          {
            "queue": "zeiko-notify-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-staging"
          },
          {
            "queue": "zeiko-cleanup-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-staging"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "zeiko_events_staging"
        }
      ],
      "ratelimits": [
        {
          "name": "RL_AUTH",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "1002",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "RL_SHARE_CREATE",
          "namespace_id": "1003",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "RL_SHARE_SEND",
          "namespace_id": "1004",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_DOWNLOAD",
          "namespace_id": "1005",
          "simple": {
            "limit": 600,
            "period": 60
          }
        },
        {
          "name": "RL_AD_BOOK",
          "namespace_id": "1006",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_REPORT",
          "namespace_id": "1007",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "media": {
        "binding": "MEDIA"
      }
    },
    "production": {
      "routes": [
        {
          "pattern": "drive.zeiko.biz.id",
          "custom_domain": true
        },
        {
          "pattern": "uc.zeiko.biz.id",
          "custom_domain": true
        },
        {
          "pattern": "s3.zeiko.biz.id",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "5 * * * *"
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://drive.zeiko.biz.id",
        "USERCONTENT_ORIGIN": "https://uc.zeiko.biz.id",
        "S3_ORIGIN": "https://s3.zeiko.biz.id",
        "EMAIL_FROM": "no-reply@zeiko.biz.id",
        "ADAPTER_EMAIL": "relay",
        "MAIL_RELAY_URL": "https://mailer.zeiko.biz.id",
        "ADAPTER_PAYMENT": "zeiko",
        "ADAPTER_ACCOUNTS": "zeiko",
        "ZEIKO_DOOR_URL": "https://auth.zeiko.biz.id",
        "ZEIKO_SITE_URL": "https://zeiko.biz.id",
        "ADAPTER_SCANNER": "mock",
        "ADAPTER_CSAM": "mock",
        "ADAPTER_MEDIA": "cloudflare",
        "ADAPTER_ARCHIVER": "none",
        "R2_BUCKET_NAME": "zeiko-production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zeiko-production",
          "database_id": "4f80570d-4b92-45b2-b38b-a0ce8858b357",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "zeiko-production"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "da96bcde410f45f28c29c08de2bd6009"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SCAN_QUEUE",
            "queue": "zeiko-scan-production"
          },
          {
            "binding": "ARCHIVE_QUEUE",
            "queue": "zeiko-archive-production"
          },
          {
            "binding": "COMPRESS_QUEUE",
            "queue": "zeiko-compress-production"
          },
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "zeiko-notify-production"
          },
          {
            "binding": "CLEANUP_QUEUE",
            "queue": "zeiko-cleanup-production"
          }
        ],
        "consumers": [
          {
            "queue": "zeiko-scan-production",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-production"
          },
          {
            "queue": "zeiko-archive-production",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-production"
          },
          {
            "queue": "zeiko-compress-production",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-production"
          },
          {
            "queue": "zeiko-notify-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-production"
          },
          {
            "queue": "zeiko-cleanup-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "zeiko-dlq-production"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "zeiko_events_production"
        }
      ],
      "ratelimits": [
        {
          "name": "RL_AUTH",
          "namespace_id": "2001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "2002",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "RL_SHARE_CREATE",
          "namespace_id": "2003",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "RL_SHARE_SEND",
          "namespace_id": "2004",
          "simple": {
            "limit": 10,
