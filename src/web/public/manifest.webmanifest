{
  "name": "Zeiko Cloud Storage",
  "short_name": "Zeiko",
  "description": "Simpan, buka, dan bagikan file dari mana saja.",
  "lang": "id",
  "id": "/drive",
  "start_url": "/drive",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#4338ca",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "shortcuts": [
    { "name": "Terbaru", "url": "/terbaru" },
    { "name": "Dibagikan", "url": "/dibagikan" }
  ]
}
