{
  "name": "zeiko-cloud-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zeiko Cloud Storage — penyimpanan awan murah untuk Indonesia (Cloudflare Workers + R2 + D1).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false dev/server.ts",
    "dev:web": "vite",
    "dev:reset": "node scripts/dev-reset.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist/web', { recursive: true, force: true })\" && vite build",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run --env staging",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:dry:nodocker": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run --env staging --containers-rollout=none",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.12",
    "@better-auth/utils": "0.5.0",
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@corbe30/fortune-excel": "2.3.5",
    "@fortune-sheet/react": "1.0.4",
    "@hono/zod-validator": "^0.9.1",
    "@lezer/highlight": "1.2.5",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "docx": "9.14.0",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "mediabunny": "1.61.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
