# Copy to .dev.vars for local overrides (never commit .dev.vars).
# Every key has an insecure dev default in dev/vars.ts, so this file is optional.
# APP_ORIGIN=http://localhost:5173
# USERCONTENT_ORIGIN=http://uc.localhost:8790
# BETTER_AUTH_SECRET=...
# DOWNLOAD_SECRET=...
# SHARE_LINK_SECRET=...
# PREVIEW_SECRET=...
# CONTACTS_ENC_KEY=... (32 bytes, base64)
# IP_HASH_SECRET=...
# PAYMENT_WEBHOOK_SECRET=...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_WEBHOOK_SECRET=...
# TURNSTILE_SECRET_KEY=...
