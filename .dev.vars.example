# Copy to .dev.vars for local overrides (never commit .dev.vars).
# Every key has an insecure dev default in dev/vars.ts, so this file is optional.
# APP_ORIGIN=http://localhost:5173
# USERCONTENT_ORIGIN=http://uc.localhost:8790
# BETTER_AUTH_SECRET=...
# DOWNLOAD_SECRET=...
# SHARE_LINK_SECRET=...
# PREVIEW_SECRET=...
# CONTACTS_ENC_KEY=... (32 bytes, base64)
# IP_HASH_SECRET=...
# PAYMENT_WEBHOOK_SECRET=...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_WEBHOOK_SECRET=...
# TURNSTILE_SECRET_KEY=...
# Zeiko Accounts (ADR-036). Dev uses the stand-in door at /__dev/door, so these are only for
# trying the real relay door locally:
# ADAPTER_ACCOUNTS=zeiko
# ADAPTER_PAYMENT=zeiko
# ZEIKO_DOOR_URL=https://auth.zeiko.biz.id
# ZEIKO_SITE_URL=https://zeiko.biz.id
# ZEIKO_APP_TOKEN=... (relay → Zeiko Drive → Setup → Mint app token)
# ZEIKO_OPS_TOKEN=... (relay → Zeiko Drive → Setup → Mint ops key)
